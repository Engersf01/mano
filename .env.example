# Optional — enables the AI assistant, captioning relay, and coach features
OPENAI_API_KEY=

# Required for the avatar console (/avatar) — LiveAvatar API key.
#
# Get it from https://app.liveavatar.com/developers (log in with your HeyGen
# credentials). LiveAvatar is a SEPARATE platform from HeyGen's classic API and
# the keys are not interchangeable — a key from app.heygen.com/settings?nav=API
# will be rejected. API access needs a paid plan.
#
# HEYGEN_API_KEY is also accepted as an alias for this value.
LIVEAVATAR_API_KEY=

# Optional — override the LiveAvatar API base URL (defaults to
# https://api.liveavatar.com). Useful for pointing at a mock during development.
LIVEAVATAR_API_URL=

# Vercel build env (do not edit)
NEXT_TELEMETRY_DISABLED=1

# --- Speaker hub (/speaker) ---------------------------------------------------

# Required to open the host console at /speaker/host. One shared passcode; it
# guards a roster of attendee names and emails, so make it long and don't reuse
# one. With this unset the console refuses to open at all.
SPEAKER_HOST_PASSCODE=

# Where the hub keeps bookings, volunteers and survey answers.
#
# With these two set, it uses Vercel KV / Upstash over REST — the only option
# that survives a serverless deployment, where every instance otherwise gets
# its own empty scratch disk and sign-ups vanish. Leave them unset for local
# development and self-hosting, where the store is a JSON file instead.
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted as aliases.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional — where the JSON file store lives when KV is not configured.
# Defaults to .data/speaker.json (git-ignored).
SPEAKER_DATA_FILE=

# Optional — the video the hub opens with, before the host sets one in the
# console. A YouTube, Vimeo, or direct .mp4/.webm URL.
NEXT_PUBLIC_SPEAKER_VIDEO_URL=
