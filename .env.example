# Optional — enables the AI assistant, captioning relay, and coach features
OPENAI_API_KEY=

# Required for the avatar console (/avatar) — LiveAvatar API key.
#
# Get it from https://app.liveavatar.com/developers (log in with your HeyGen
# credentials). LiveAvatar is a SEPARATE platform from HeyGen's classic API and
# the keys are not interchangeable — a key from app.heygen.com/settings?nav=API
# will be rejected. API access needs a paid plan.
#
# HEYGEN_API_KEY is also accepted as an alias for this value.
LIVEAVATAR_API_KEY=

# Optional — override the LiveAvatar API base URL (defaults to
# https://api.liveavatar.com). Useful for pointing at a mock during development.
LIVEAVATAR_API_URL=

# Vercel build env (do not edit)
NEXT_TELEMETRY_DISABLED=1

# --- Public address -----------------------------------------------------------

# The short conference hostname. On this host `/` serves the speaker hub
# instead of the Mano stage, so the address on a slide is the whole URL.
# Defaults to meet.engers.me; set it only if the domain changes.
NEXT_PUBLIC_SITE_HOST=

# Optional — the absolute origin used for canonical and Open Graph URLs.
# Defaults to https://$NEXT_PUBLIC_SITE_HOST, so it is only needed when the
# scheme or port differs (a staging domain, local HTTPS).
NEXT_PUBLIC_SITE_URL=

# --- Speaker hub (/speaker) ---------------------------------------------------

# Required to open the host console at /speaker/host. One shared passcode; it
# guards a roster of attendee names and emails, so make it long and don't reuse
# one. With this unset the console refuses to open at all.
SPEAKER_HOST_PASSCODE=

# Optional — a six-digit PIN for the floating host button on /speaker, which
# shows who has booked or volunteered and how to contact them. Exactly six
# digits; anything else counts as unset and the button is not rendered at all.
#
# It is deliberately weaker than SPEAKER_HOST_PASSCODE because it is typed on a
# phone in a hallway, so the endpoint locks a client out for 15 minutes after 5
# wrong tries. Do not remove that limit and keep the PIN: six digits is a
# million guesses, which is minutes of work against an endpoint that allows
# unlimited attempts. Use SPEAKER_HOST_PASSCODE and /speaker/host for anything
# beyond glancing at the roster.
SPEAKER_ADMIN_PIN=

# Where the hub keeps bookings, volunteers and survey answers.
#
# With these two set, it uses Vercel KV / Upstash over REST — the only option
# that survives a serverless deployment, where every instance otherwise gets
# its own empty scratch disk and sign-ups vanish. Leave them unset for local
# development and self-hosting, where the store is a JSON file instead.
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted as aliases.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional — where the JSON file store lives when KV is not configured.
# Defaults to .data/speaker.json (git-ignored).
SPEAKER_DATA_FILE=

# Optional — overrides the video the hub opens with. Defaults to the session
# recording this repo serves itself, /media/neumomeet-90s.mp4. Accepts a
# YouTube, Vimeo or Google Drive share link, a direct .mp4/.webm URL, or a
# root-relative path to another file under public/.
NEXT_PUBLIC_SPEAKER_VIDEO_URL=
